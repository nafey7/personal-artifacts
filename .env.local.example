MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=artifacts

# Sending mail: verification and password-reset codes. Use a sending-only
# Resend key — the app must never hold one that can reconfigure the domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Pallason <noreply@pallason.com>

# How long a deleted artifact waits in the trash before it is removed for
# good. Optional; 7 days if unset. Changing it re-applies to the TTL index on
# the next boot, existing trashed artifacts included.
TRASH_RETENTION_DAYS=7
